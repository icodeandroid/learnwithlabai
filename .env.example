# Optional — forward every "Connect With Us" submission to a webhook
# (n8n, Make, Zapier, or your own endpoint). Leave unset and leads are
# logged to the server console instead.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Website chatbot (Groq). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
